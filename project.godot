; Engine configuration file.
config_version=5

[application]

config/name="Shift Happens"
config/description="Game Off 2026 entry. Theme: SHIFT."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

