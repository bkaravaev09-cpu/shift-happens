static func has(c: String) -> bool:
	return DATA.has(c)


## Returns voxel coords (x right, y down) of filled pixels for a character.
static func pixels(c: String) -> Array[Vector2i]:
	var res: Array[Vector2i] = []
	if not DATA.has(c):
		return res
	var rows: Array = DATA[c]
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			if row[x] == "#":
				res.append(Vector2i(x, y))
	return res
